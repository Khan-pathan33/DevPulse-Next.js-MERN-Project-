# DevPulse Environment Configuration

# MongoDB Connection String (Optional - DevPulse includes an automatic, resilient in-memory fallback if left unconfigured)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/devpulse?retryWrites=true&w=majority
# Or local: mongodb://localhost:27017/devpulse
MONGODB_URI=

# Public Site Domain (used for dynamic sitemap and SEO meta generation)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Administrator Credentials (Server-only, keep private in .env.local)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YourStrongPassword123!
